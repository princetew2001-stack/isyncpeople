<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Data extraction rules for Android 12+ (API 31+)
    This prevents sensitive data from being backed up to cloud
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude SharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="."/>
        
        <!-- Exclude database files -->
        <exclude domain="database" path="."/>
        
        <!-- Exclude cache -->
        <exclude domain="file" path="cache/."/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Also exclude from device-to-device transfer -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
